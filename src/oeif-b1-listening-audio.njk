{% macro trackList(files) %}
  <div class="audio-track-list">
    {% for file in files %}
      {% set url = audioBase ~ file %}
      <article class="audio-track">
        <div>
          <h3>{{ file | replace("_", " ") | replace(".mp3", "") | title }}</h3>
          <p>{{ file }}</p>
        </div>
        <audio controls preload="none" src="{{ url | url }}"></audio>
        <a class="btn btn-outline" href="{{ url | url }}" download>MP3 herunterladen</a>
      </article>
    {% endfor %}
  </div>
{% endmacro %}

<section class="hero hero-dual">
  <div class="container">
    <p class="eyebrow">Audio zum Buch</p>
    <h1>ÖIF B1 Hören Audio</h1>
    <p class="hero-intro">Hier finden Sie alle MP3-Dateien zum Übungsbuch. Sie können die Audios direkt abspielen oder einzeln herunterladen.</p>
