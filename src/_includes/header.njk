{% set navLinks = pageNavLinks or [] %}
<header class="site-header">
  <div class="container">
    <a href="{{ (homeUrl or '/') | pageUrl }}" class="logo">
      <img
        src="{{ '/assets/logo.png' | url }}"
        alt=""
        class="logo-image"
        width="500"
        height="500"
      >
      <span class="logo-text">{{ site.brand.shortName }}</span>
    </a>
    <div class="header-right">
      <nav class="main-nav">
        <a href="{{ (homeUrl or '/') | pageUrl }}">{{ ui.homeLabel or 'Home' }}</a>
        {% for link in navLinks %}
          <a href="{{ link.url | pageUrl }}">{{ link.label }}</a>
        {% endfor %}
      </nav>
      {% if primaryCta %}
        <a href="{{ primaryCta.url | pageUrl }}" class="btn btn-primary header-cta">{{ primaryCta.label }}</a>
      {% endif %}
    </div>
  </div>
</header>
