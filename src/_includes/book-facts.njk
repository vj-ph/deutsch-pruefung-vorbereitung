{% set book = site.books[bookKey] %}
{% set displayBookTitle = bookDisplayTitle or book.title %}
{% set priceUiByLang = {
  "en": { "kindleUnlimitedPrefix": "Free with Kindle Unlimited or " },
  "ar": { "kindleUnlimitedPrefix": "مجاني مع Kindle Unlimited أو " },
  "ru": { "kindleUnlimitedPrefix": "Бесплатно с Kindle Unlimited или " },
  "uk": { "kindleUnlimitedPrefix": "Безкоштовно з Kindle Unlimited або " },
  "tr": { "kindleUnlimitedPrefix": "Kindle Unlimited ile ücretsiz veya " },
  "sr": { "kindleUnlimitedPrefix": "Besplatno uz Kindle Unlimited ili " }
} %}
{% set priceUi = priceUiByLang[currentLang or "en"] or priceUiByLang["en"] %}
{% if book.thumbnailPath %}
<a
  href="{{ ctaLink(book.gumroad.fullBook, { content: book.key ~ '-thumbnail-' ~ (currentLang or 'en') }) }}"
  class="book-thumbnail"
  target="_blank"
  rel="noopener"
  aria-label="{{ displayBookTitle }}"
  data-ga-event="cta_click"
  data-ga-cta-type="thumbnail"
  data-ga-book="{{ book.key }}"
  data-ga-location="book-facts"
  data-ga-language="{{ currentLang or 'en' }}"
>
  <img
    src="{{ book.thumbnailPath | url }}"
    alt="{{ displayBookTitle }} cover"
    class="book-thumbnail__image"
    width="1024"
    height="1024"
    loading="lazy"
    decoding="async"
  >
</a>
{% endif %}
<div class="book-facts">
  {% if book.purchaseOptions %}
    {% for option in book.purchaseOptions %}
  {% if option.priceDisplay %}
  {% set optionPriceDisplay = option.priceDisplay %}
  {% if option.key == "amazon-kindle" and option.priceDisplay %}
    {% set optionPriceDisplay = priceUi.kindleUnlimitedPrefix ~ option.priceDisplay %}
  {% endif %}
  <div class="book-fact">
    <span class="book-fact__label">{{ option.label }}</span>
    <strong>{{ optionPriceDisplay }}</strong>
  </div>
  {% endif %}
    {% endfor %}
  {% else %}
  <div class="book-fact">
    <span class="book-fact__label">{{ productUi.fullBook }}</span>
    <strong>{{ site.sales.fullBookPriceDisplay }}</strong>
  </div>
  {% endif %}
  <div class="book-fact">
    <span class="book-fact__label">{{ productUi.freeSample }}</span>
    <strong>{{ productUi.free }}</strong>
  </div>
  {% if not book.purchaseOptions %}
    <div class="book-fact">
      <span class="book-fact__label">{{ productUi.format }}</span>
      <strong>{{ book.format or site.sales.format }}</strong>
    </div>
  {% endif %}
  <div class="book-fact">
    <span class="book-fact__label">{{ productUi.pages }}</span>
    <strong>{{ book.pageCount }}</strong>
  </div>
</div>
<p class="book-note">{{ productUi.clickNote }}</p>
<p class="book-note book-note--accent">{{ productUi.discountPrefix }}{{ book.discountCode }}{{ productUi.discountSuffix }}</p>
